# Optional: your own Falling Fruit API key.
# Leave unset to use the public production key (the app works out of the box).
# In dev, Vite reads this and injects it into the /api proxy.
# In production on Cloudflare Pages, set it as a secret instead:
#   npx wrangler pages secret put FF_API_KEY
FF_API_KEY=

# Optional: a MapTiler API key (https://www.maptiler.com, free tier).
# When set, the app uses MapTiler's prettier basemap styles; when empty it
# falls back to keyless OpenFreeMap. This key ships in the client bundle, so
# restrict it to your domain(s) in the MapTiler dashboard.
# In Cloudflare Pages, add VITE_MAPTILER_KEY as a (plain) build env var.
VITE_MAPTILER_KEY=
